# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a
# device; this may be used with UUID= as a more robust way to name devices
# that works even if disks are added and removed. See fstab(5).
#
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
/dev/disk/by-uuid/5d53b1b0-6a9a-4dea-8e29-167fff399da5 none swap sw 0 0
# / was on /dev/sda3 during curtin installation
/dev/disk/by-uuid/980b4d55-41a1-4298-9e91-1bc41c8fc17b / ext4 defaults 0 1
# /boot/efi was on /dev/sda1 during curtin installation
/dev/disk/by-uuid/2563-112C /boot/efi vfat defaults 0 1
tmpfs /home/marask/accounts tmpfs defaults,size=150G,uid=1001,gid=1001 0 0
tmpfs /run/accounts tmpfs size=50G,noatime 0 0
